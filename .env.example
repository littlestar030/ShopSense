# Root-level defaults used by Docker Compose and local scripts.
OPENAI_API_KEY=
USE_MOCK_OPENAI=false
HF_TOKEN=
CHAT_MODEL=gpt-4o-mini
TEXT_EMBEDDING_MODEL=text-embedding-3-small
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
THIRD_PARTY_LOG_LEVEL=WARNING
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_READY_PATH=/readyz
BACKEND_READY_TIMEOUT=120
FRONTEND_DEV_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
AUTO_BUILD_INDEXES=true
FORCE_REBUILD_INDEXES=false
ENABLE_BACKGROUND_WARMUP=true
WARMUP_CLIP_MODEL=true
ENABLE_PERSONALIZATION=true
PREPARE_CATALOG_ON_RUN=false
BUILD_INDEXES_ON_RUN=true
FORCE_REBUILD_INDEXES_ON_RUN=false
KAGGLE_MAX_PRODUCTS=1200
KAGGLE_MAX_PER_ARTICLE=60
KAGGLE_MIN_ARTICLE_COUNT=20
KAGGLE_SAMPLE_SEED=42
